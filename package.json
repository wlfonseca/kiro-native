{
  "name": "kiro-native",
  "version": "0.1.0",
  "description": "Native opencode provider for Kiro models \u2014 direct kiro.dev API, no kiro-cli subprocess",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean",
    "login": "node bin/kiro-native.mjs login"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.7.0"
  },
  "license": "MIT",
  "author": "Wellington Fonseca",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wlfonseca/kiro-native.git"
  },
  "homepage": "https://github.com/wlfonseca/kiro-native#readme",
  "bugs": {
    "url": "https://github.com/wlfonseca/kiro-native/issues"
  },
  "keywords": [
    "opencode",
    "opencode-provider",
    "kiro",
    "ai-sdk",
    "glm",
    "claude",
    "amazon-q"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "kiro-native": "bin/kiro-native.mjs"
  }
}